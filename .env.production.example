# Copy to .env.production on the server and fill every value. Never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

NOTION_API_KEY=
# 联网搜索 API Key 由登录用户在「连接 → 搜索引擎」中配置。
# 迁移期间仍可设置 TAVILY_API_KEY / EXA_API_KEY / BRAVE_SEARCH_API_KEY 作为服务端后备。
# The production Compose stack provides Redis on its private network.
REDIS_URL=redis://redis:6379

CRON_SECRET=
# Encrypts runtime configuration and every user's LLM API key.
# Generate with: openssl rand -base64 32. This key stays only in .env.production.
CONFIG_ENCRYPTION_KEY=
# Comma-separated Supabase Auth emails allowed to edit runtime configuration.
CONFIG_ADMIN_EMAILS=
