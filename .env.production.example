# Copy to .env.production on the server and fill every value. Never commit it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

NOTION_API_KEY=
TAVILY_API_KEY=
# The production Compose stack provides Redis on its private network.
REDIS_URL=redis://redis:6379

CRON_SECRET=
# Generate with: openssl rand -base64 32. This key stays only in .env.production.
CONFIG_ENCRYPTION_KEY=
# Comma-separated Supabase Auth emails allowed to edit runtime configuration.
CONFIG_ADMIN_EMAILS=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Opt-in: mirror detailed memory lifecycle logs to server stdout and browser Console.
MEMORY_DEBUG_LOGS=false
