SANDBOX_BROKER_ENV=production
SANDBOX_STORE=postgres
SANDBOX_DATABASE_URL=postgres://sandbox:replace@127.0.0.1:5432/personal_assistant?sslmode=require
SANDBOX_RUNTIME=podman
SANDBOX_WORKER_ID=replace-with-stable-server-worker-id
SANDBOX_WORKSPACE_ROOT=/var/lib/personal-assistant/sandbox/workspaces
SANDBOX_ARTIFACT_ROOT=/var/lib/personal-assistant/sandbox/artifacts
SANDBOX_SKILL_IMAGE_DIGEST=registry.example/sandbox/skill@sha256:replace-with-64-hex-digest
SANDBOX_CODING_IMAGE_DIGEST=registry.example/sandbox/coding@sha256:replace-with-64-hex-digest
