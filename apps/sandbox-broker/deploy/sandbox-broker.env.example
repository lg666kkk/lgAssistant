SANDBOX_BROKER_ENV=production
SANDBOX_BROKER_HOST=127.0.0.1
SANDBOX_BROKER_PORT=8081
SANDBOX_BROKER_AUTH_DISABLED=false
SANDBOX_BROKER_AUTH_SECRET=replace-with-at-least-32-random-bytes
SANDBOX_BROKER_AUTH_MAX_AGE_SECONDS=300
SANDBOX_STORE=postgres
SANDBOX_DATABASE_URL=postgres://sandbox:replace@127.0.0.1:5432/personal_assistant?sslmode=require
SANDBOX_RUNTIME=disabled
